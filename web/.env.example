# Variable NAMES only. Copy to web/.env.local (gitignored) and fill in locally; a container
# build passes them as build args instead. Both are baked in at build time.
#
# The product's name as the SPA shows it (wordmark, page title, web app manifest).
# Optional: default "HLS VOD". At most 40 characters, no < > & " ' ` or control characters.
VITE_BRAND_NAME=
# Optional: a trailing part of VITE_BRAND_NAME drawn in the accent colour. Default "VOD" for the
# default name, none for any other name.
VITE_BRAND_ACCENT=
