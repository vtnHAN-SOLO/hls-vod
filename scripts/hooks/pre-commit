#!/usr/bin/env bash
# Blocks commits containing secrets. Installed by scripts/install-hooks.sh.
set -euo pipefail

# Tools from `make setup` live in GOPATH/bin, which may not be on a GUI/IDE PATH.
if command -v go >/dev/null 2>&1; then
  PATH="$(go env GOPATH)/bin:$PATH"
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found — run 'make setup'" >&2
  exit 1
fi

exec gitleaks protect --staged --redact --no-banner
