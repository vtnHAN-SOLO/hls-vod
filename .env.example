# Variable NAMES only. Copy to .env (gitignored) and fill in locally.
# Secrets have no defaults: a missing one makes the service exit at startup.

# --- secrets (required) ---
# Read by the docker-compose Postgres container on first start.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Read by api, watcher, dispatcher, transcoder (job mode), useradmin and `make migrate`. Must match the three values above.
DATABASE_URL=
# Signs and verifies access tokens (HS256), read by the api. At least 32 bytes.
# Generate one with: openssl rand -base64 48
JWT_SIGNING_KEY=
# Signs /media/ URLs (api) and verifies them (compose media-delivery): the same value for both.
# At least 32 bytes of base64 characters. Generate one with: openssl rand -base64 48
MEDIA_SIGNING_KEY=

# --- client address (api) ---
# Required, may be empty (no default). Comma-separated CIDRs of the proxies in front of the api;
# X-Forwarded-For is believed only through them, read from the right. Empty (local development):
# the client is the TCP peer and the header is ignored. Production: the edge proxy's address as
# the cluster sees it (through the tunnel) and the cluster's pod CIDR
# (edge reverse proxy -> tunnel -> ingress controller -> api).
TRUSTED_PROXIES=

# --- registration and mail (api) ---
# Required: true or false, no default. false turns POST /api/v1/auth/register off (403);
# login, verify-email and resend keep working.
REGISTRATION_OPEN=
# Required: resend or log, no default. log writes every mail, link included, to the api log
# instead of sending it; the api refuses it unless HTTP_ADDR is loopback.
MAIL_BACKEND=
# Required when REGISTRATION_OPEN=true. The sender, and the SPA origin the mailed links point at
# (http://127.0.0.1:5173 for `make web-dev`). Quote MAIL_FROM in single quotes, e.g.
#   MAIL_FROM='HLS VOD <noreply@your-domain>'
# because make loads .env with the shell: unquoted, the space splits the value and < > are read
# as redirections, so the targets fail.
MAIL_FROM=
PUBLIC_BASE_URL=
# Secret, required when MAIL_BACKEND=resend: a Resend API key with sending access.
RESEND_API_KEY=
# Optional: at most this many mails in any 24 hours (default 90, under Resend's free 100/day).
MAIL_DAILY_CAP=
# Required when REGISTRATION_OPEN=true; set both or neither. TURNSTILE_SECRET_KEY is a secret.
# Locally, Cloudflare's documented test keys work (they always pass). Never commit a key.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- sign in with Google (api), optional ---
# Both or neither; unset turns Google off and hides its button. GOOGLE_CLIENT_SECRET is a secret.
# A "Web application" OAuth client whose authorized redirect URI is
# {PUBLIC_BASE_URL}/api/v1/auth/google/callback (http://127.0.0.1:5173/api/v1/auth/google/callback
# for `make web-dev`); PUBLIC_BASE_URL is then required.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- optional (defaults shown in internal/config) ---
LOG_LEVEL=
HTTP_ADDR=
SHUTDOWN_TIMEOUT=
# api, local development only: every signed media URL expires after this (e.g. 2m) instead of
# 6 h / 24 h, to see a 410. The api refuses to start with it unless HTTP_ADDR is loopback.
DEV_MEDIA_URL_TTL=

# --- dispatcher (`make dispatch` sets DISPATCH_BACKEND=local and TRANSCODER_BIN itself) ---
# DISPATCH_BACKEND is required (local | kubernetes) with no default.
DISPATCH_BACKEND=
TRANSCODER_BIN=
MAX_CONCURRENT=
POLL_INTERVAL=
JOB_DEADLINE=
# kubernetes backend only, set by the manifests (planned). DATABASE_SECRET_NAME/KEY name an
# existing Secret: the Job reads DATABASE_URL from it, the value never enters the Job spec.
K8S_NAMESPACE=
TRANSCODER_IMAGE=
DATABASE_SECRET_NAME=
DATABASE_SECRET_KEY=
MEDIA_PVC=
MEDIA_MOUNT_PATH=
JOB_TTL=
TRANSCODER_RUN_AS_USER=
TRANSCODER_RUN_AS_GROUP=
TRANSCODER_SERVICE_ACCOUNT=
IMAGE_PULL_SECRET=
TRANSCODER_CPU_REQUEST=
TRANSCODER_CPU_LIMIT=
TRANSCODER_MEMORY_REQUEST=
TRANSCODER_MEMORY_LIMIT=

# --- media tree (required by the watcher, the dispatcher's local backend, `make dev-ingest`
# and compose media-delivery) ---
# Holds inbox/, sources/ and library/. Locally ./var/media (var/ is gitignored).
MEDIA_ROOT=
